# ==============================================================================
# Heritage AI Decay Monitoring System - Environment Configuration
# ==============================================================================

# Dataset Configuration
# Relative or absolute path to the local monument image dataset
DATASET_ROOT=../TEMPLE

# Annotations Directory
ANNOTATIONS_DIR=./ai/annotations

# Preprocessed Data Directory
PROCESSED_DATA_DIR=./ai/dataset/processed

# Model Configuration
MODEL_ARCHITECTURE=SSD
MODEL_BACKBONE=mobilenet_v2
INPUT_IMAGE_SIZE=300
NUM_CLASSES=4

# Training Hyperparameters
BATCH_SIZE=8
LEARNING_RATE=0.001
NUM_EPOCHS=50
DEVICE=cuda

# Backend & API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True
